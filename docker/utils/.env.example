# Copy this file to .env next to docker-compose.yml before testing Google sign-in through Dex.
# docker compose automatically reads .env from this directory and passes these values to Dex.

# Google OAuth client credentials used by the Dex Google connector.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Add this exact URI to the Google OAuth client's authorized redirect URIs.
GOOGLE_REDIRECT_URI=http://127.0.0.1:5556/callback
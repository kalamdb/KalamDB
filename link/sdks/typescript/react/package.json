{
  "name": "@kalamdb/react",
  "type": "module",
  "version": "0.5.3-rc.1",
  "description": "React bindings for KalamDB live queries and mutation state",
  "license": "Apache-2.0",
  "author": "KalamDB Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalamdb/KalamDB"
  },
  "homepage": "https://github.com/kalamdb/KalamDB#readme",
  "bugs": {
    "url": "https://github.com/kalamdb/KalamDB/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"const fs=require('fs');try{fs.rmSync('dist',{recursive:true,force:true})}catch{}\"",
    "ensure:linked-orm": "node -e \"const fs=require('fs');process.exit(fs.existsSync('node_modules/@kalamdb/orm/dist/index.js')&&fs.existsSync('../orm/node_modules/drizzle-orm')&&fs.existsSync('../orm/node_modules/@kalamdb/client/dist/src/index.js')?0:1)\" || (npm --prefix ../orm install --no-audit --no-fund && npm --prefix ../orm run build && npm install --no-package-lock --no-save ../orm)",
    "build": "npm run clean && tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run ensure:linked-orm",
    "test": "npm run build && npm run typecheck && vitest run --environment jsdom",
    "test:e2e": "npm --prefix tests/e2e/app install && npm run build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@kalamdb/client": ">=0.5.3-0 <0.6.0",
    "@kalamdb/orm": ">=0.5.3-0 <0.6.0",
    "drizzle-orm": ">=0.45.2",
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "@kalamdb/orm": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kalamdb/client": "file:../client",
    "@kalamdb/orm": "file:../orm",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "undici": "^7.28.0",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  },
  "keywords": [
    "kalamdb",
    "react",
    "live-queries",
    "realtime",
    "database"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}

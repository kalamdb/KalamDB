{{header}}
// {{contract_hash_line}}

export * from './schema.js';
{{#if has_type_imports}}
import type { {{type_imports}} } from './schema.js';
{{/if}}

export const KALAM_CONTRACT_EPOCH = 1 as const;
export const KALAM_CODEC_VERSION = 1 as const;

export interface OperationDescriptor<TInput = unknown, TOutput = unknown> {
  readonly epoch: typeof KALAM_CONTRACT_EPOCH;
  readonly codecVersion: typeof KALAM_CODEC_VERSION;
  readonly routineId: string;
  readonly signature: string;
  readonly schema: string;
  readonly name: string;
  readonly cardinality: "void" | "scalar" | "setof" | "table";
  readonly __input?: TInput;
  readonly __output?: TOutput;
}

export interface KalamCall<TOutput = unknown> {
  readonly operation: OperationDescriptor<unknown, TOutput>;
  readonly arguments: unknown;
}

export interface InvocationOptions {
  readonly signal?: AbortSignal;
  readonly timeoutMs?: number;
  readonly idempotencyKey?: string;
  readonly format?: 'binary' | 'json';
}

export type KalamQueryClient = {
  query: (sql: string, params?: unknown[]) => Promise<{
    status?: string;
    error?: unknown;
    results?: Array<{
      rows?: unknown;
      named_rows?: Array<Record<string, unknown>>;
    }>;
  }>;
  invokeRoutine: <I, O>(
    descriptor: OperationDescriptor<I, O>,
    input: I,
    options?: InvocationOptions,
  ) => Promise<O>;
};

{{#if has_calls}}
function routineDescriptor(routineId: string, signature: string, schema: string, name: string, cardinality: OperationDescriptor["cardinality"]) {
  return { epoch: KALAM_CONTRACT_EPOCH, codecVersion: KALAM_CODEC_VERSION, routineId, signature, schema, name, cardinality } as const;
}

{{/if}}
export function createKalam({{#if has_calls}}client: KalamQueryClient{{else}}_client?: KalamQueryClient{{/if}}) {
  const functions = {
{{#each namespaces}}
    {{object_ident}}: {
{{#each procedures}}
{{{jsdoc}}}      {{method_ident}}: ({{#if has_params}}input: {{request_ident}}, {{/if}}options?: InvocationOptions): Promise<{{result_ident}}> =>
        client.invokeRoutine(
          routineDescriptor("{{routine_id}}", "{{signature}}", "{{schema}}", "{{name}}", "{{cardinality}}"),
          {{#if has_params}}input{{else}}undefined{{/if}},
          options,
        ),
{{/each}}
    },
{{/each}}
  };
  const operations = {
{{#each namespaces}}
    {{object_ident}}: {
{{#each procedures}}
      {{method_ident}}: ({{#if has_params}}input: {{request_ident}}{{/if}}): KalamCall<{{result_ident}}> => ({
        operation: routineDescriptor("{{routine_id}}", "{{signature}}", "{{schema}}", "{{name}}", "{{cardinality}}"),
        arguments: {{#if has_params}}input{{else}}undefined{{/if}},
      }),
{{/each}}
    },
{{/each}}
  };
  return {
    contract: {
      epoch: KALAM_CONTRACT_EPOCH,
      contractHash: "{{contract_hash_line}}".replace(/^contract_hash:\s*/, ""),
    } as const,
    functions,
    operations,
    ...functions,
  };
}

export function createKalamFunctions({{#if has_calls}}client: KalamQueryClient{{else}}_client?: KalamQueryClient{{/if}}) {
  return createKalam({{#if has_calls}}client{{else}}_client{{/if}}).functions;
}

[project]
name = "{{project_name}}"
default_env = "dev"
{{#if package_manager}}
package_manager = "{{package_manager}}"
{{/if}}

[connection.dev]
url = "{{server_url}}"
namespace = "{{namespace}}"

[schema]
mode = "{{schema_mode}}"
path = "{{schema_path}}"
watch = true
languages = {{languages_array}}

{{#if typescript}}
[schema.targets.typescript]
output = "src/generated/kalam.ts"
{{/if}}
{{#if dart}}
[schema.targets.dart]
output = "lib/generated/kalam.dart"
{{/if}}

[migrations]
auto_create = true

[dev]
auto_start_db = {{auto_start_db}}
apply_schema = true
generate_types = true
watch = true

# Commands under [dev.processes] start automatically with `kalam dev` alongside the
# KalamDB server and schema pipeline. Logs are prefixed with the process name (for example
# `[app]`) so they stay distinct from `[cli]` workflow output and `[server]` database logs.
{{#if dev_process_command}}
[dev.processes]
app = "{{dev_process_command}}"
{{else}}
# [dev.processes]
# app = "npm run dev"
{{/if}}

[logging]
file = true
capture_process_output = true

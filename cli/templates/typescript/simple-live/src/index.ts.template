import { Auth, createClient } from '@kalamdb/client';
import { liveTable } from '@kalamdb/orm';
import { users } from './generated/kalam.js';

const url = process.env.KALAM_URL ?? '{{server_url}}';
const namespace = process.env.KALAM_NAMESPACE ?? '{{namespace}}';
const username = process.env.KALAM_USER ?? 'root';
const password = process.env.KALAM_PASSWORD;

async function main(): Promise<void> {
  if (!password) {
    throw new Error(
      'KALAM_PASSWORD is required. For local projects created with kalam init, check .env in the project root.',
    );
  }

  const client = createClient({
    url,
    namespace,
    authProvider: async () => Auth.basic(username, password),
  });

  console.log('Subscribing to users table...');
  
  const stop = await liveTable(client, users, (liveRows) => {
    console.log(`\nReceived ${liveRows.length} row(s):`);
    liveRows.forEach((row) => {
      console.log(row);
    });
  }, { lastRows: 50 });

  // Insert 3 random users after 1 second
  setTimeout(async () => {
    console.log('\n--- Inserting 3 random users ---');
    for (let i = 0; i < 3; i++) {
      const randomId = Math.floor(Math.random() * 1000000);
      const email = `user${randomId}@example.com`;
      
      await client.insert(`users`, {
        id: randomId,
        email,
        created_at: new Date(),
      });
      
      console.log(`Inserted user: id=${randomId}, email=${email}`);
    }
  }, 1000);

  // Keep listening for 30 seconds then stop
  setTimeout(async () => {
    console.log('\nStopping subscription...');
    await stop();
    await client.disconnect();
  }, 30_000);
}

main().catch((error) => {
  console.error('Failed to query KalamDB:', error);
  process.exitCode = 1;
});

# All credentials in this file are read by SERVER-SIDE processes only
# (server/index.ts, src/agent/index.ts, scripts/setup.ts). They are never
# bundled into the browser app — Vite only inlines variables prefixed with
# VITE_, and this file deliberately uses no such prefixes.
#
# The browser fetches a short-lived KalamDB token from /api/auth/token at
# runtime; see server/index.ts for the issuance logic and src/client.ts for
# the client side.

# ---------------------------------------------------------------------------
# KalamDB connection (backend, agent, setup scripts)
# ---------------------------------------------------------------------------
KALAMDB_URL=http://127.0.0.1:8080
KALAMDB_USER=root
KALAMDB_PASSWORD=kalamdb-dev-password

# Consumer group + task topic the agent subscribes to. Override only if you
# run multiple parallel agent fleets and need to isolate their work queues.
# KALAMDB_GROUP=chat-agents
# KALAMDB_TASK_TOPIC=chat.task_events

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
PORT=3001

# When true, the backend honors X-Forwarded-For for per-IP rate limiting and
# request logging. Set ONLY behind a trusted reverse proxy that strips or
# replaces client-supplied XFF — otherwise an attacker can rotate the header
# and bypass the rate limiter.
# TRUST_PROXY=0

# Comma-separated CSRF allow-list for /api/auth/token. Any cross-origin POST
# whose Origin header is not in this list gets a 403. Same-origin script
# fetches don't send Origin and are allowed unconditionally. Set this to the
# scheme://host[:port] of your deployed frontend in production.
# ALLOWED_ORIGINS=http://127.0.0.1:5173,https://your-frontend.example

# Per-IP rate limits (requests/minute) and health-probe cache window (ms).
# TOKEN_RATE_LIMIT_PER_MINUTE=10
# HEALTH_RATE_LIMIT_PER_MINUTE=60
# HEALTH_CACHE_MS=2000

# ---------------------------------------------------------------------------
# Production fence
# ---------------------------------------------------------------------------
# The starter's /api/auth/token does NOT authenticate the caller — anyone who
# reaches it can mint a KalamDB token. The backend refuses to boot when
# NODE_ENV=production unless ALLOW_UNAUTHENTICATED_TOKENS=true is set. Setting
# that flag means you understand the boundary (private network / internal
# demo only). Real apps should plug user auth into server/index.ts and remove
# this fence entirely. See README "Plugging in real auth".
# NODE_ENV=development
# ALLOW_UNAUTHENTICATED_TOKENS=false

# ---------------------------------------------------------------------------
# LLM provider (agent)
# ---------------------------------------------------------------------------
# All keys optional. With no keys set, the agent uses a mock adapter that
# still exercises the streaming, approval, and cancellation flows (it
# recognizes phrases like "delete my account" to demonstrate the approval
# checkpoint).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 'openai' | 'anthropic' | 'mock'. Auto-detected from the keys above when
# unset; set explicitly to force a specific path.
# LLM_PROVIDER=

# ---------------------------------------------------------------------------
# Embeddings (RAG / search_documents tool)
# ---------------------------------------------------------------------------
# 'openai' uses OPENAI_API_KEY to call /v1/embeddings. 'fake' emits a
# deterministic hash-based vector — fine for tests and offline demos, useless
# for actual semantic search.
# EMBEDDING_PROVIDER=openai

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=info
# LOG_SERVICE=chat-starter

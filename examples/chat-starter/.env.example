# All credentials in this file are read by SERVER-SIDE processes only
# (server/index.ts, src/agent/index.ts, scripts/setup.ts). They are never
# bundled into the browser app — Vite only inlines variables prefixed with
# VITE_, and this file deliberately uses no such prefixes.
#
# The browser fetches a short-lived KalamDB token from /api/auth/token at
# runtime; see server/index.ts for the issuance logic and src/client.ts for
# the client side.

# KalamDB connection (used by the backend, agent, and setup scripts)
KALAMDB_URL=http://127.0.0.1:8080
KALAMDB_USER=root
KALAMDB_PASSWORD=kalamdb-dev-password

# Backend API port (server/index.ts). Vite proxies /api/* here.
PORT=3001

# Optional. Without this, the agent uses a mock LLM with canned replies that
# still triggers the approval flow when the user says things like
# "delete my account". Set a real key to use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Set this to use Anthropic instead of OpenAI. If both are set,
# LLM_PROVIDER decides; if neither is set, the mock adapter is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. 'openai' | 'anthropic' | 'mock'. Auto-detected from the keys
# above when unset.
LLM_PROVIDER=

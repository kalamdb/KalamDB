{
  "name": "kalamdb-chat-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-ready KalamDB + React AI chat starter — typing, approvals, cancellable tasks, pluggable LLM",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "agent": "tsx watch src/agent/index.ts",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalamdb/client": "file:../../link/sdks/typescript/client",
    "@kalamdb/consumer": "file:../../link/sdks/typescript/consumer",
    "@kalamdb/orm": "file:../../link/sdks/typescript/orm",
    "@kalamdb/react": "file:../../link/sdks/typescript/react",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.469.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}

{
  "name": "kalamdb-chat-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KalamDB + React AI chat starter — streaming, approvals, cancellable tasks, pluggable LLM",
  "scripts": {
    "dev": "concurrently -k -n vite,server,agent -c cyan,magenta,yellow \"npm:vite\" \"npm:server\" \"npm:agent\"",
    "vite": "vite --host 127.0.0.1",
    "server": "tsx watch server/index.ts",
    "agent": "tsx watch src/agent/index.ts",
    "setup": "tsx scripts/setup.ts",
    "seed-docs": "tsx scripts/seed-docs.ts",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:component && playwright test",
    "test:unit": "cross-env NODE_ENV=test tsx --test tests/unit/*.test.ts",
    "test:component": "cross-env NODE_ENV=test vitest run",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.agent.json --noEmit"
  },
  "dependencies": {
    "@kalamdb/client": "file:../../link/sdks/typescript/client",
    "@kalamdb/consumer": "file:../../link/sdks/typescript/consumer",
    "@kalamdb/orm": "file:../../link/sdks/typescript/orm",
    "@kalamdb/react": "file:../../link/sdks/typescript/react",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.469.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  }
}

{
  "name": "live-okf-context-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OKF folder sync showcase: KalamDB live() + local SQLite mirror",
  "scripts": {
    "dev": "node --preserve-symlinks --preserve-symlinks-main --import tsx src/sync/sync-app.ts",
    "build": "tsc",
    "test": "tsc && node --preserve-symlinks --preserve-symlinks-main --import tsx --test tests/*.test.ts",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/@kalamdb/orm/node_modules/drizzle-orm';try{fs.rmSync(p,{recursive:true,force:true})}catch{}\""
  },
  "dependencies": {
    "@kalamdb/client": "file:../../link/sdks/typescript/client",
    "@kalamdb/orm": "file:../../link/sdks/typescript/orm",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@kalamdb/orm": {
      "drizzle-orm": "$drizzle-orm"
    }
  }
}

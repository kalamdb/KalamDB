{
  "name": "kalamdb-chat-with-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Realtime multi-user React chat with SHARED rooms, RLS, and a topic agent",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "agent": "node --preserve-symlinks --preserve-symlinks-main --import tsx src/agent.ts",
    "test": "tsc -p tsconfig.test.json && node --preserve-symlinks --preserve-symlinks-main --import tsx --test tests/agent.test.ts tests/project.test.ts && playwright test"
  },
  "dependencies": {
    "@kalamdb/client": "file:../../link/sdks/typescript/client",
    "@kalamdb/consumer": "file:../../link/sdks/typescript/consumer",
    "@kalamdb/orm": "file:../../link/sdks/typescript/orm",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0"
  }
}

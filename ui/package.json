{
  "name": "kalamdb-admin-ui",
  "private": true,
  "version": "0.1.0-rc1",
  "license": "Apache-2.0",
  "author": "KalamDB Team",
  "type": "module",
  "scripts": {
    "build:sdk": "cd ../link/sdks/typescript/client && npm install && npm run build",
    "build:orm": "cd ../link/sdks/typescript/orm && npm install && npm run build && node -e \"const fs=require('fs');for(const p of ['node_modules/drizzle-orm','node_modules/@kalamdb/client']){try{fs.rmSync(p,{recursive:true,force:true})}catch{}}\"",
    "generate:schema": "npm run build:sdk && npm run build:orm && node ../link/sdks/typescript/orm/dist/cli.js --out src/lib/schema.ts --namespace system --namespace dba",
    "clean": "node -e \"const fs=require('fs');const rm=(p)=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}};rm('node_modules/.vite');rm('dist')\"",
    "clean:all": "node -e \"const fs=require('fs');const rm=(p)=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}};rm('node_modules/.vite');rm('dist');rm('node_modules/@kalam')\"",
    "reinstall": "npm run clean:all && npm run build:sdk && npm run build:orm && npm install && vite",
    "dev": "vite",
    "dev:fresh": "npm run clean:all && npm run build:sdk && npm run build:orm && npm install && vite",
    "prebuild": "npm run build:sdk && npm run build:orm",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:sql-studio": "vitest run src/services/sqlStudioService.test.ts src/pages/SqlStudio.test.tsx src/components/sql-studio-v2/input-form/sqlCompletionCatalog.test.ts",
    "test:flows": "vitest run src/components/auth/LoginForm.test.tsx src/components/auth/ProtectedRoute.test.tsx src/components/auth/SetupGuard.test.tsx src/pages/SetupWizard.test.tsx src/pages/SqlStudio.test.tsx"
  },
  "dependencies": {
    "@kalamdb/client": "file:../link/sdks/typescript/client",
    "@kalamdb/orm": "file:../link/sdks/typescript/orm",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-deep-equal": "^3.1.3",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.13",
    "undici": "^7.29.0"
  }
}
